<Project Sdk="Dalamud.NET.Sdk/13.0.0">
  <PropertyGroup>
    <RootNamespace>AddonWatcher</RootNamespace>
    <AssemblyName>AddonWatcher</AssemblyName>
    <WarningLevel>4</WarningLevel>
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <Use_DalamudPackager>false</Use_DalamudPackager>
  </PropertyGroup>

  <ItemGroup>
    <!-- ISigScanner is in Dalamud.Game in API 13 (it moved to Dalamud.Plugin.Services in API 15). -->
    <Using Include="Dalamud.Game" />
  </ItemGroup>
</Project>