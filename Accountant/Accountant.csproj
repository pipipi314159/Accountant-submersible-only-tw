<Project Sdk="Dalamud.NET.Sdk/13.0.0">
  <PropertyGroup>
    <RootNamespace>Accountant</RootNamespace>
    <AssemblyName>Accountant</AssemblyName>
    <Version>1.8.3.3</Version>
    <Company>SoftOtter</Company>
    <Product>Accountant</Product>
    <Copyright>Copyright © 2025</Copyright>
    <WarningLevel>4</WarningLevel>
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <!-- Submersible-only build: the task/map timers use IChatMessage, which does not exist in API 13. -->
  <ItemGroup>
    <Compile Remove="Manager\TimerManager.TaskManager.cs" />
    <Compile Remove="Manager\TimerManager.MapManager.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Accountant.GameData\Accountant.GameData.csproj" />
    <ProjectReference Include="..\AddonWatcher\AddonWatcher.csproj" />
  </ItemGroup>
</Project>